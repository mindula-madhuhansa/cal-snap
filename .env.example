# Copy to .env.local and adjust. Every variable here is read in app.config.ts
# and validated at startup by src/config/env.ts.
#
# Only non-secret values belong in this file: anything prefixed EXPO_PUBLIC_
# ships inside the installed app and can be read out of it.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Identity (spec 0004). Clerk Dashboard -> API keys -> Publishable key.
# Safe to ship: it names an instance, it does not grant anything.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# The Supabase project (spec 0004). Both safe to ship: with Clerk the
# anonymous key grants nothing on its own, because every row level security
# policy now requires a valid Clerk token.
EXPO_PUBLIC_SUPABASE_URL=https://kfzlocqwrzgkyqkzphfq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
