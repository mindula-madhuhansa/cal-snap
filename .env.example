# Copy to .env.local and adjust. Every variable here is read in app.config.ts
# and validated at startup by src/config/env.ts.
#
# Only non-secret values belong in this file: anything prefixed EXPO_PUBLIC_
# ships inside the installed app and can be read out of it.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Added by feature 5 (Account & sign in), both safe to ship:
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
